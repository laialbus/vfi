<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scheduled decider: reviews and merges the PRs the team left behind.
  Runs two hours after the lead, when the team session has hit its timeout.

  Install to ~/Library/LaunchAgents/com.vfi.agent.decider.plist
  Load:   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.vfi.agent.decider.plist
  Unload: launchctl bootout gui/$(id -u)/com.vfi.agent.decider

  Do not install until M2's gates exist and a supervised dry run has passed.
  VFI_ROLE=decider is what the merge-guard hook honors; this file and run.sh
  live outside the repository so no agent can grant itself the role.

  No absolute personal paths in this file: bash expands $HOME in the program
  string, and run.sh derives its work root from its own location. The /tmp
  files below catch only failures before run.sh takes over.

  No secrets in this file. It is world-readable.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vfi.agent.decider</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/projects/systems/vfi_ws/run.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>VFI_ROLE</key>
    <string>decider</string>
    <key>VFI_WORKER_ID</key>
    <string>99</string>
    <key>VFI_TIMEOUT</key>
    <string>1800</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>5</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/com.vfi.agent.decider.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.vfi.agent.decider.err.log</string>
</dict>
</plist>
